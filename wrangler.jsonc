{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upstream",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "upstream",
      "database_id": "54390f17-084d-4e9d-9b35-351576189a84",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "upstream-trace",
      "binding": "TRACE_WORKFLOW",
      "class_name": "TraceWorkflow"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://upstream.hamdanesmail12-7a9.workers.dev",
    "PAID_DEEP_BUDGET_USD": "8"
  },
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
}
